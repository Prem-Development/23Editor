# 23Editor backend configuration template.
# Copy to .env and fill in real values. Never commit .env (it is git-ignored).
# No secrets are stored in this file.

# Meta Model API key from https://dev.meta.ai (API keys tab, starts with LLM_).
META_API_KEY=

# Optional: non-default key variable name, also honored.
# MODEL_API_KEY=

# Optional overrides (defaults shown).
# META_API_BASE=https://api.meta.ai/v1
# BACKEND_PORT=8080
# BACKEND_STORAGE=./storage
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
